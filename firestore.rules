rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User profile document: only the authenticated owner can read/write
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User playlists subcollection
      match /playlists/{playlistId} {
        allow read, write: if isOwner(userId);
      }

      // User library / favorites subcollection
      match /library/{document=**} {
        allow read, write: if isOwner(userId);
      }

      // Any other user-scoped subcollections (e.g., insights, history)
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Deny all other access by default
    match /{document=**} {
      allow read, write: false;
    }
  }
}
